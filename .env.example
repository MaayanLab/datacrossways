DB_PASSWORD_FILE=./secrets/postgres_password
FLASK_SECRET_KEY_FILE=./secrets/flask_secret_key
PUBLIC_BASE_URL=http://localhost
HTTP_PORT=80
DEVELOPMENT=false
ADMIN_EMAIL=admin@example.org
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
# Leave empty for AWS S3. Set for MinIO, Ceph, R2, and other S3-compatible APIs.
S3_ENDPOINT_URL=
# auto, path, or virtual; path is commonly required by local/custom providers.
S3_ADDRESSING_STYLE=auto
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
POSTGRES_DB=datacrossways
POSTGRES_USER=datacrossways
# API database connection. Defaults target the bundled local-db profile.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=datacrossways
DB_USER=datacrossways
# prefer, require, verify-ca, verify-full, disable, etc.
DB_SSLMODE=prefer
